EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# New Firebase projects require a billing-enabled Cloud Storage bucket for uploads.
# Keep this false until Storage is enabled and its rules have been deployed.
EXPO_PUBLIC_FIREBASE_PROFILE_PHOTO_UPLOADS_ENABLED=false

# OAuth client IDs from the same Firebase/Google Cloud project.
EXPO_PUBLIC_FIREBASE_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FIREBASE_GOOGLE_IOS_CLIENT_ID=

# Reversed iOS client ID, for example com.googleusercontent.apps.123-abc.
# This is consumed while Expo creates the native iOS build.
EXPO_PUBLIC_FIREBASE_GOOGLE_IOS_URL_SCHEME=

# Sign in with Apple requires an enrolled Apple Developer Program team.
# Set false for Personal Team simulator builds so the app fails cleanly instead of opening an invalid client flow.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=true

# Optional development-only screen QA: profile, setup, or loading.
EXPO_PUBLIC_PROFILE_PREVIEW=

# Legacy development flag. Prefer EXPO_PUBLIC_ONBOARDING_TEST_SCENARIO.
EXPO_PUBLIC_IS_ONBOARDING=false

# Development-only launch QA:
# normal | fresh | resume-2 ... resume-8 | signup | guest-complete
EXPO_PUBLIC_ONBOARDING_TEST_SCENARIO=normal

# Anonymous, allow-listed product analytics. Leave the API key empty to keep
# analytics disabled. Session replay, GeoIP, person profiles, and autocapture
# remain disabled by the app.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Crash/error monitoring. Leave the DSN empty to keep Sentry disabled.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source-map upload values belong in EAS/build secrets, not this file:
# SENTRY_ORG, SENTRY_PROJECT, and SENTRY_AUTH_TOKEN.

# RevenueCat public platform SDK keys. These are safe to embed in the client;
# never use a RevenueCat secret API key here. The default offering must expose
# exactly one $rc_lifetime package granting the premium entitlement. Leave a
# platform key empty to keep Premium purchases disabled for that build.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Development-only Premium QA: normal | paywall | premium.
EXPO_PUBLIC_PREMIUM_TEST_SCENARIO=normal

# Development-only launch QA: normal | programs.
EXPO_PUBLIC_PROGRAMS_TEST_SCENARIO=normal

# Development-only launch QA: normal | progress.
EXPO_PUBLIC_PROGRESS_TEST_SCENARIO=normal

# Development-only completion QA: normal | feedback.
EXPO_PUBLIC_COMPLETION_TEST_SCENARIO=normal

# Development-only punch-guide QA: normal | guide.
EXPO_PUBLIC_PUNCH_GUIDE_TEST_SCENARIO=normal

# Prints allow-listed analytics events during local QA without transmitting
# them when no PostHog API key is configured.
EXPO_PUBLIC_TELEMETRY_DEBUG_ENABLED=false
